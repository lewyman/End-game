{
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "methods": ["GET","POST","PUT","DELETE","PATCH","OPTIONS"], "dest": "/api/index" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
